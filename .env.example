# ResolveAI local backend configuration
#
# Copy this file to F:\ResolveAI\.env. Put provider credentials only in that
# private file. Never place them in frontend/.env files, source code, logs,
# test fixtures, or API requests. The backend reads the private file; Vite
# frontend variables are not a credential store.

# Optional provider credentials. Leave blank for deterministic/local-only V1.
GROQ_API_KEY=
GEMINI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
OPENROUTER_API_KEY=
MODELSCOPE_API_KEY=
AGNES_API_KEY=
CHUTES_API_KEY=

# Provider model identifiers and explicit provider switches.
RESOLVEAI_GROQ_MODEL=
RESOLVEAI_GEMINI_MODEL=
RESOLVEAI_OPENROUTER_MODEL=
RESOLVEAI_CLOUDFLARE_MODEL=
RESOLVEAI_MODELSCOPE_MODEL=
RESOLVEAI_MODELSCOPE_BASE_URL=
RESOLVEAI_AGNES_MODEL=
RESOLVEAI_CHUTES_MODEL=
RESOLVEAI_GROQ_ENABLED=false
RESOLVEAI_GEMINI_ENABLED=false
RESOLVEAI_OPENROUTER_ENABLED=false
RESOLVEAI_CLOUDFLARE_ENABLED=false
RESOLVEAI_MODELSCOPE_ENABLED=false
RESOLVEAI_AGNES_ENABLED=false
RESOLVEAI_CHUTES_ENABLED=false

# External inference is fail-closed. Keep zero-cost mode enabled unless the
# owner has explicitly approved a credentialed provider evaluation.
RESOLVEAI_EXTERNAL_INFERENCE_ENABLED=false
RESOLVEAI_MODEL_DISCOVERY_ENABLED=false
RESOLVEAI_MODEL_CATALOG_TTL_SECONDS=21600
RESOLVEAI_ZERO_COST_MODE=true
RESOLVEAI_PROVIDER_REQUEST_QUOTA=0
RESOLVEAI_PROVIDER_TOKEN_QUOTA=0
RESOLVEAI_PROVIDER_QUOTA_WINDOW_SECONDS=86400
RESOLVEAI_PROVIDER_TIMEOUT_SECONDS=8
RESOLVEAI_PROVIDER_MAX_CONCURRENCY=1
RESOLVEAI_PROVIDER_MAX_OUTPUT_TOKENS=256

# Trusted synthetic evaluation controls. These are disabled by default and
# are not accepted from customer requests. Configure them only for a separate
# owner-run evaluation harness after its budget and privacy gates pass.
RESOLVEAI_EVALUATION_ENABLED=false
RESOLVEAI_EVALUATION_EXPERIMENT_ID=
RESOLVEAI_EVALUATION_ALLOWED_PROVIDERS=
# Exact provider:model_id entries, for example groq:llama-3.3-70b-versatile,
# gemini:gemini-2.0-flash. Leave blank unless a bounded tranche is approved.
RESOLVEAI_EVALUATION_ALLOWED_MODEL_IDS=
RESOLVEAI_EVALUATION_MAX_MODELS_PER_PROVIDER=2
RESOLVEAI_EVALUATION_REQUEST_QUOTA=0
RESOLVEAI_EVALUATION_TOKEN_QUOTA=0
RESOLVEAI_EVALUATION_MAX_CONCURRENCY=1
RESOLVEAI_EVALUATION_QUOTA_WINDOW_SECONDS=86400

# Existing local application settings.
RESOLVEAI_ENVIRONMENT=local
RESOLVEAI_DATABASE_URL=sqlite+pysqlite:///:memory:
RESOLVEAI_COMMERCE_DATABASE_URL=
RESOLVEAI_AUTH_SECRET_KEY=
RESOLVEAI_DEMO_AUTH_ENABLED=true
RESOLVEAI_DEMO_SESSION_TTL_SECONDS=3600
RESOLVEAI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RESOLVEAI_POLICY_RETRIEVAL=lexical
RESOLVEAI_SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional cached local policy-answer model. Leave blank to keep deterministic
# generation/fallback as the normal customer path. This never downloads a model.
RESOLVEAI_LOCAL_POLICY_MODEL=
RESOLVEAI_LOCAL_POLICY_TIMEOUT_SECONDS=8
RESOLVEAI_LOCAL_POLICY_MAX_NEW_TOKENS=256
